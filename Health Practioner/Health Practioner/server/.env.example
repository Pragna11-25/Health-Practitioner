# ==============================================
# BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================

# Server Configuration
# PORT: Server port (default: 5000)
# In production (Render), set to the port provided by the platform
PORT=5000

# Client Configuration
# CLIENT_ORIGIN: Allowed origin for CORS and Socket.IO connections
# LOCAL: http://localhost:5173 (Vite dev server)
# PRODUCTION: https://your-vercel-domain.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Configuration
# MONGODB_URI: Full MongoDB connection string from Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT Configuration
# JWT_SECRET: Secret key for JWT signing (use strong, random string)
# JWT_EXPIRES_IN: Token expiration time
JWT_SECRET=your_strong_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# File Upload Configuration
# MAX_FILE_SIZE_MB: Maximum file upload size in MB
MAX_FILE_SIZE_MB=20

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# Render: Set PORT as environment variable in Render dashboard
# MongoDB Atlas: Whitelist Render IP in Atlas Network Access
# JWT_SECRET: Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

