# ==============================================
# FRONTEND ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================

# API Configuration
# VITE_API_URL: Backend API base URL
# LOCAL: http://localhost:5000/api
# PRODUCTION: https://your-render-backend-url.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO Configuration
# VITE_SOCKET_URL: Backend Socket.IO URL
# LOCAL: http://localhost:5000
# PRODUCTION: https://your-render-backend-url.onrender.com
# Note: Socket.IO automatically uses wss:// for HTTPS connections
VITE_SOCKET_URL=http://localhost:5000

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# Vercel: Set environment variables in Vercel dashboard (Project Settings > Environment Variables)
# Frontend will automatically use production URLs when built with these variables
# Socket.IO: Automatically upgrades to wss:// on production HTTPS domains

